{
  "version": 2,
  "rewrites": [
    { "source": "/", "destination": "/pos.html" },
    { "source": "/api/orders/today", "destination": "/api/orders-today" },
    { "source": "/api/orders/:token/cancel", "destination": "/api/order?token=:token" },
    { "source": "/api/orders/:token", "destination": "/api/order?token=:token" },
    { "source": "/api/menu/item/:id/delete", "destination": "/api/menu-item?id=:id&action=delete" },
    { "source": "/api/menu/item/:id", "destination": "/api/menu-item?id=:id" },
    { "source": "/api/menu/item", "destination": "/api/menu-item" },
    { "source": "/api/settings/prices", "destination": "/api/settings" },
    { "source": "/api/settings/admin", "destination": "/api/settings" },
    { "source": "/api/backup/:date", "destination": "/api/backup?date=:date" }
  ]
}